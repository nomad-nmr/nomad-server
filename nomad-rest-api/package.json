{
  "name": "nomad-rest-api",
  "version": "3.8.0-beta.1",
  "description": "REST API back-end for NOMAD system",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test-once": "env-cmd -f ../envs/dev/backend-test.env vitest --run",
    "test-action": "vitest --run",
    "test": "env-cmd -f ../envs/dev/backend-test.env vitest --reporter verbose",
    "coverage": "env-cmd -f ../envs/dev/backend-test.env vitest run --coverage",
    "start": "env-cmd -f ../envs/dev/api-no-docker.env node server.js",
    "dev": "env-cmd -f ../envs/dev/api-no-docker.env nodemon server.js",
    "dev-docker": "nodemon server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@zakodium/nmrium-core-plugins": "^0.7.71",
    "bcrypt-salt": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-validator": "^7.0.1",
    "file-collection": "^6.6.1",
    "filelist-utils": "^1.9.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.1",
    "jszip": "^3.7.1",
    "moment": "^2.29.1",
    "moment-duration-format": "^2.3.2",
    "moment-timezone": "^0.6.2",
    "mongoose": "^9.2.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openchemlib": "^9.18.2",
    "socket.io": "^4.5.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "env-cmd": "^11.0.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "mongodb-memory-server@11.2.0": true,
    "@scarf/scarf": false
  }
}